{
  "realm": "sparelink",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "CUSTOMER" },
      { "name": "ADMIN" }
    ]
  },
  "clients": [
    {
      "clientId": "sparelink-api",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"]
    }
  ],
  "users": [
    {
      "username": "customer",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "customer", "temporary": false }],
      "realmRoles": ["CUSTOMER"]
    },
    {
      "username": "admin",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["ADMIN"]
    }
  ]
}
